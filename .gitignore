__pycache__/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.pyc

# Index pages are fully derived from the report files under runs/ and are
# rebuilt on demand (run.py / build_indexes.py) and at Pages deploy time, so
# they don't need to be committed.
/index.html
runs/*/index.html

# The schema reference page (and its support CSS/JS, copied alongside it by
# json-schema-for-humans) is fully derived from spec-schema.json and is
# rebuilt on demand (build_schema_docs.py) and at Pages deploy time, so none
# of it needs to be committed.
/spec-schema.html
/schema_doc.css
/schema_doc.min.js
